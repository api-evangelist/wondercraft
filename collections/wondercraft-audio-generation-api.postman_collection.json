  "info": {
    "_postman_id": "93a626e6-193c-4717-ac0e-6c703eac630e",
    "name": "Wondercraft Public Account Audio Generation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Wondercraft Public API creates audio content - podcasts, audio ads, meditations, and audiobooks - from an AI-generated or user-supplied script. Generation is asynchronous: a create request returns a job_id, which is then polled for completion and an MP3 download URL. Voices and background music are referenced by IDs copied from the Wondercraft platform. API access requires a paid plan.\n\nContact Support:\n Name: Wondercraft Support",
      "type": "text/plain"
    }
  }
