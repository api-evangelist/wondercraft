          "request": {
            "name": "Create any audio content with a user-provided script",
            "description": {
              "content": "Generates audio from a user-provided script of ordered segments, each pairing text with a Wondercraft voice ID. Optionally accepts a background music spec. Returns a job_id to poll for status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "podcast",
                "scripted"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
