            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"script\": [\n    {\n      \"text\": \"<string>\",\n      \"voice_id\": \"<string>\"\n    },\n    {\n      \"text\": \"<string>\",\n      \"voice_id\": \"<string>\"\n    }\n  ],\n  \"music_spec\": {\n    \"music_id\": \"<string>\",\n    \"fade_in_ms\": 0,\n    \"fade_out_ms\": 0,\n    \"playback_start\": 0,\n    \"playback_end\": \"<integer>\",\n    \"volume\": 0.05,\n    \"loop\": false\n  }\n}",
