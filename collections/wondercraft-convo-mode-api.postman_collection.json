                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"voice_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"delivery_instructions\": \"<string>\",\n  \"music_spec\": {\n    \"music_id\": \"<string>\",\n    \"fade_in_ms\": 0,\n    \"fade_out_ms\": 0,\n    \"playback_start\": 0,\n    \"playback_end\": \"<integer>\",\n    \"volume\": 0.05,\n    \"loop\": false\n  }\n}",
