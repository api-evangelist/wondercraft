          "name": "Generate AI-scripted podcast with 2 hosts using Convo Mode",
          "request": {
            "name": "Generate AI-scripted podcast with 2 hosts using Convo Mode",
            "description": {
              "content": "Generates a two-host conversational podcast from a natural-language prompt. Requires exactly two voice IDs and accepts optional delivery instructions and a background music spec. Returns a job_id to poll for status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "podcast",
                "convo-mode",
                "ai-scripted"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
