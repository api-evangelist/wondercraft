{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wondercraft Public Account API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Verify API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wondercraft.ai/v1/verify"
          },
          "docs": "Verifies the supplied API key and returns the associated account email."
        }
      ]
    }
  ],
  "bundled": true
}